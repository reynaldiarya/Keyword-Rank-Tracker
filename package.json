{
  "name": "keyword-rank-tracker",
  "version": "1.1.0",
  "description": "A high-performance SEO utility designed to automate search engine ranking monitoring across multiple scraping providers.",
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "dev": "npm run build:assets && concurrently --kill-others --names server,css,client \"npm:dev:server\" \"npm:dev:css\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:css": "npm run build:css -- --watch=always",
    "dev:client": "npm run build:client -- --watch=forever",
    "build": "tsc && npm run build:assets",
    "build:assets": "npm run build:css && npm run build:client",
    "build:css": "tailwindcss --input src/web/styles.css --output dist/assets/tracker.css --minify",
    "build:client": "esbuild src/web/client.ts --bundle --minify --format=esm --target=es2022 --outfile=dist/assets/tracker.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src package.json tsconfig.json eslint.config.mjs README.md"
  },
  "keywords": [
    "keyword",
    "rank",
    "tracker",
    "seo",
    "google"
  ],
  "author": "reynaldiarya",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@hono/zod-validator": "^0.9.1",
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "hono": "^4.13.19",
    "puppeteer": "^25.18.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
